// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_TEST")
}


model Movie {
  id Int @id @default(autoincrement())
  title String @unique
  description String
  category String
  preview String 
  published   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews     Reviews[] 

  author User   @relation(fields: [authorId], references: [id])

  favoriteMovies UserFavoriteMovies[] 
  actors ActorsOnMovies[]

  ratings Rating[]
  // avgRating Float?
  avgRating Float @default(0)


  actorsList String[]
  authorId Int
}

model Reviews{
  id Int @id @default(autoincrement())    @unique
  user  User @relation(fields: [auId], references: [id])
  movie     Movie    @relation(fields: [movieId], references: [id])
  movieId   Int 
  auId Int 
  review String @db.VarChar(2550)
  positive Boolean
  createdAt DateTime @default(now())
}


model Actors{
    id Int @default(autoincrement())  @unique
    preview String
    name String @unique
    age String
    // movieId Int[] 
    movies ActorsOnMovies[]
}

model ActorsOnMovies {
  actor Actors @relation(fields: [actorId], references: [id])
  actorId Int
  movie Movie @relation(fields: [movieId], references: [id])
  movieId Int

  @@id([actorId, movieId])
}


model VerifyResetToken{
  user User? @relation(fields: [userId], references: [id])
  userId Int @unique
  token String @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model UserFavoriteMovies{
  userId Int
  movieId Int 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([userId,movieId ])
}

model User{
  id Int @id @default(autoincrement())
  createdAt DateTime  @default(now())
  name      String
  email     String    @unique
  roles String[] @default(["User"])

  password  String
  updatedAt DateTime  @updatedAt

  movies Movie[]
  token VerifyResetToken[]
  reviews Reviews[]

  favoriteMovies UserFavoriteMovies[] 


  isEmailVerified Boolean @default(false)
  refreshToken String[]

  ratings Rating[]

}


model Rating{
  id Int @id @default(autoincrement())
  value Int 
  user User @relation(fields: [userId], references: [id])
  userId Int
  movie   Movie  @relation(fields: [movieId], references: [id])
  movieId Int
 
 @@unique([userId, movieId])

}