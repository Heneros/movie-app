// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Movie {
  id          Int    @id @default(autoincrement())
  title       String @unique
  description String
  category    String
  year          Int
  director     DirectorsOnMovie[]


  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews Reviews[]

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  favoriteMovies UserFavoriteMovies[]
  actors         ActorsOnMovies[]
  ratings        Rating[]

  galleryId Int? @unique()
  gallery   Gallery? @relation(name: "GalleryMovie", fields: [galleryId], references: [id])

  previewId Int?    @unique()
  preview   Avatar[]
  avgRating Float   @default(0)
  

  actorsList String[]
  authorId   Int?
}

model Reviews {
  id        Int      @id @unique @default(autoincrement())
  user      User     @relation(fields: [auId], references: [id])
  movie     Movie    @relation(fields: [movieId], references: [id])
  movieId   Int
  auId      Int
  review    String   @db.VarChar(2550)
  positive  Boolean
  createdAt DateTime @default(now())
}

model Actors {
  id   Int    @unique @default(autoincrement())
  name String @unique
  age  String

  previewId Int? @unique()

  avatar Avatar[]

  movies    ActorsOnMovies[]
  gallery Gallery[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model ActorsOnMovies {
  actor   Actors @relation(fields: [actorId], references: [id], onDelete: Cascade)
  actorId Int
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId Int

  @@id([actorId, movieId])
}

model Director {
  id     Int                @id @default(autoincrement())
  name   String @unique()
  movies DirectorsOnMovie[]
}

model DirectorsOnMovie {
  movie     Movie    @relation(fields: [movieId], references: [id])
  movieId   Int

  director  Director @relation(fields: [directorId], references: [id])
  directorId Int

  @@id([directorId, movieId])
}



model VerifyResetToken {
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId    Int      @unique
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model UserFavoriteMovies {
  userId  Int
  movieId Int
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie   Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
}

model User {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  name      String
  email     String   @unique
  roles     String[] @default(["User"])

  password  String
  updatedAt DateTime @updatedAt

  token          VerifyResetToken[] 
  reviews        Reviews[]          
  favoriteMovies UserFavoriteMovies[] 
  ratings        Rating[]        
  movie          Movie[]           

  avatar         Avatar?         @relation("UserAvatars")

  isEmailVerified Boolean  @default(false)
  refreshToken    String[]


  blocked Boolean @default(false)


  provider  String?
  googleId  String? @unique()
  githubId  String? @unique()
  discordId String? @unique()
}

model Avatar {
  id       Int    @id @default(autoincrement())
  url      String
  publicId String @unique()


 user User? @relation("UserAvatars",  fields: [userId], references: [id], onDelete: Cascade)
userId Int?  @unique()

 movie Movie? @relation(fields: [previewId], references: [id], onDelete: Cascade)
previewId Int?  @unique()

actors Actors?  @relation(fields: [actorsId], references: [id], onDelete: Cascade)
actorsId Int?    @unique()

  createdAt DateTime @default(now())
}

model Gallery{
    id Int @id @default(autoincrement())
    url String 
    publicId String 
    // movie Movie? @relation(name: "GalleryMovie",fields: [movieId], references: [id])
    movie Movie? @relation(name: "GalleryMovie")

    movieId Int?
    actors Actors? @relation( fields: [actorId], references: [id]) 
    actorId Int?
    createdAt DateTime @default(now())
}



model Rating {
  id      Int   @id @default(autoincrement())
  value   Int
  user    User  @relation(fields: [userId], references: [id])
  userId  Int
  movie   Movie @relation(fields: [movieId], references: [id])
  movieId Int


  @@unique([userId, movieId])
}
