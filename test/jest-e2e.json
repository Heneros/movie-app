{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "../",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "extensionsToTreatAsEsm": [
    ".ts"
  ],
  "testSequencer": "<rootDir>/test/helpers/custom-helper-sequencer.ts",
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1"
  },
  "testPathIgnorePatterns": [
    "/node_modules/",
    "/users/",
    "/auth/",
    "/movie/createMovie.e2e-spec.ts",
    "/movie/getByIdMovie.e2e-spec.ts",
    "/movie/getAllMovies.e2e-spec.ts",
    "/movie/searchMovie.e2e-spec.ts",
    "/movie/getDraftsMovie.e2e-spec.ts",
    "/movie/updateMovie.e2e-spec.ts",
    "/movie/deleteMovie.e2e-spec.ts",
    "/movie/addMovietoFavorite.e2e-spec.ts",
    "/movie/removeMovieFromFavorite.e2e-spec.ts",
    "/movie/getAllFavorite.e2e-spec.ts"
  ]
}