{
    "moduleFileExtensions": [
        "js",
        "json",
        "ts"
    ],
    "rootDir": "../",
    "testEnvironment": "node",
    "testRegex": ".e2e-spec.ts$",
    "transform": {
        "^.+\\.(t|j)s$": "ts-jest"
    },
    "maxWorkers": 1,
    "testTimeout": 120000,
    "extensionsToTreatAsEsm": [
        ".ts"
    ],
    "testSequencer": "<rootDir>/test/helpers/custom-helper-sequencer.ts",
    "moduleNameMapper": {
        "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
        "/node_modules/",
 
        "auth",
        "users",
        "movie",
        "reviews"
    ]
}