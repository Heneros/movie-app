{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "baseUrl": ".",
        "rootDir": ".",
        
        "outDir": "./dist/",
        "paths": {
            "@/*": [
                "src/*"
            ],
            "@/src/movie/*": [
                "src/movie/*"
            ],
            "@/src/users/*": [
                "src/users/*"
            ],
            "@/src/auth/*": [
                "src/auth/*"
            ],
            "@/src/redis/*": [
                "src/redis/*"
            ],
            "@types/*": [
                "src/types/*"
            ],
            "test/*": [
                "test/*"
            ]
        }
    },
    "exclude": [
        "node_modules",
        "dist",
        "test",
        "**/*.spec.ts"
    ]
}