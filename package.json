    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node",
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/src/$1"
        },
        "paths": {
            "@/*": [
                "src/*"
            ]
        },
        "globals": {
            "ts-jest": {
                "tsconfig": "<rootDir>/tsconfig.json"
            }
        }
    },
    "prisma": {
        "seed": "ts-node prisma/seed.ts"
    }
