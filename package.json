{
    "name": "nest-projectfour",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "prestart:dev": "rimraf dist",
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/src/main",
        "build:prod": "npm run build && node dist/src/main.js",
        "migrate": "prisma migrate deploy",
        "seed": "ts-node prisma/seed.ts",
        "start:with-migrations": "npm run migrate && npm run seed && npm run start:dev",
        "docker:dev": "docker compose -f docker-compose.dev.yml up -d ",
        "docker:dev:build": "docker compose -f docker-compose.dev.yml up -d --build ",
        "docker:dev:down": "docker compose -f docker-compose.dev.yml down -v",
        "docker:prod": "docker compose -f docker-compose.prod.yml up -d ",
        "docker:prod:build": "docker-compose -f docker-compose.prod.yml up -d --build",
        "docker:prod:down": "docker compose -f  docker-compose.prod.yml down",
        "prisma:dev": "cross-env DATABASE_URL=postgres://postgres:postgres@localhost:5432/moviedb?schema=public npx prisma migrate dev ",
        "prisma:docker": "npx prisma generate && npx prisma migrate dev",
        "prisma:seed": "npx prisma db seed",
        "start:docker": "npm run prisma:docker && npm run start",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json  --forceExit --detectOpenHandles",
        "prisma:prod": "npx prisma generate && npx prisma migrate deploy",
        "vercel-build": "npm run prisma:prod && npm run build"
    },
