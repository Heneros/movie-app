{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "sourceRoot": "src",
            "compilerOptions": {
        "deleteOutDir": true,
        "tsConfigPath": "tsconfig.build.json",
        "assets": [
            {
                "include": "mail/templates/**/*.hbs",
                "watchAssets": true,
                "outDir": "dist/src"
            }
        ],
        "watchAssets": true
    }
}