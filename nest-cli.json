{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/restapi/src",
  "compilerOptions": {
    "assets": [
      {
        "include": "mail/templates/**/*.hbs",
        "watchAssets": true,
        "outDir": "dist/apps/restapi/src"
      }
    ],
    "watchAssets": true,
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/restapi/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/restapi",
  "projects": {
    "restapi": {
      "type": "application",
      "root": "apps/restapi",
      "entryFile": "main",
      "sourceRoot": "apps/restapi/src",
      "compilerOptions": {
        "tsConfigPath": "apps/restapi/tsconfig.app.json"
      }
    },
    "books": {
      "type": "application",
      "root": "apps/books",
      "entryFile": "main",
      "sourceRoot": "apps/books/src",
      "compilerOptions": {
        "tsConfigPath": "apps/books/tsconfig.app.json"
      }
    }
  }
}