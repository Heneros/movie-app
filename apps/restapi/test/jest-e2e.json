{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "extensionsToTreatAsEsm": [
    ".ts"
  ],
  "testSequencer": "<rootDir>/helpers/custom-helper-sequencer.ts"
}